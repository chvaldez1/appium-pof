{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM"],
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@screens/*": ["./src/screens/*"],
      "@flows/*": ["./src/flows/*"],
      "@api/*": ["./src/api/*"],
      "@data/*": ["./src/data/*"],
      "@support/*": ["./src/support/*"],
      "@setup/*": ["./src/setup/*"],
      "@config/*": ["./config/*"],
      "@scripts/*": ["./scripts/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": ["wdio.conf.ts", "config/**/*.ts", "scripts/**/*.ts", "src/**/*.ts", "tests/**/*.ts"]
}
