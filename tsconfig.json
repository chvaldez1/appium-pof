{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM"],
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@screens/*": ["./screens/*"],
      "@flows/*": ["./flows/*"],
      "@shared/*": ["./shared/*"],
      "@tests/*": ["./tests/*"],
      "@config/*": ["./config/*"],
      "@scripts/*": ["./scripts/*"]
    }
  },
  "include": [
    "wdio.conf.ts",
    "scripts/**/*.ts",
    "config/**/*.ts",
    "tests/**/*.ts",
    "screens/**/*.ts",
    "flows/**/*.ts",
    "shared/**/*.ts"
  ]
}
