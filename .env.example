# Copy to .env.local and choose a device from: xcrun simctl list devices available
IOS_UDID=replace-with-your-device-uuid
REUSE_INSTALLED_APP=1
APP_PATH=apps/Showpass-Beta-Simulator.app
# Optional: point to your local Playwright checkout for existing QA account fixtures.
# PLAYWRIGHT_REPO_PATH=/absolute/path/to/showpass-playwright
