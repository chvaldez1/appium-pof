{
  "name": "appium-pof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Showpass beta Safari and mobile Appium QA automation",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:launch": "REUSE_INSTALLED_APP=1 TARGET=ios-app wdio run ./wdio.conf.ts --spec ./tests/app.smoke.ts",
    "test:webview": "REUSE_INSTALLED_APP=1 TARGET=ios-app wdio run ./wdio.conf.ts --spec ./tests/webview.smoke.ts",
    "test:public:dry-run": "DRY_RUN=1 node --import tsx scripts/run-with-playwright-fixtures.ts public",
    "test:public": "node --import tsx scripts/run-with-playwright-fixtures.ts public",
    "recover:public": "node --import tsx scripts/run-with-playwright-fixtures.ts recover-public",
    "test:ios:versions": "node --import tsx scripts/run-ios-app-versions.ts",
    "app:check": "node --import tsx scripts/check-ios-app-build.ts",
    "app:open": "node --import tsx scripts/ios-simulator-app.ts open",
    "app:install": "node --import tsx scripts/ios-simulator-app.ts install",
    "test:organizer:navigation": "node --import tsx scripts/run-with-playwright-fixtures.ts organizer-navigation",
    "test:login": "REUSE_INSTALLED_APP=1 TARGET=ios-app wdio run ./wdio.conf.ts --spec ./tests/ios/box-office.discovery.ts",
    "test:buyer:navigation": "BUYER_NAVIGATION_RUN=1 TARGET=ios-app wdio run ./wdio.conf.ts --spec ./tests/ios/buyer.navigation.ts",
    "test:box-office:entry": "npm run test:login",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test shared/purchase/*.test.ts scripts/*.test.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.1",
    "@wdio/appium-service": "9.32.0",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/junit-reporter": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "appium": "3.8.0",
    "appium-safari-driver": "5.0.10",
    "appium-uiautomator2-driver": "8.7.0",
    "appium-xcuitest-driver": "12.15.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
